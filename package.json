{
  "name": "translate-note",
  "type": "module",
  "version": "0.3.0",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "build:clean": "rm -f main.js styles.css",
    "build:dev": "NODE_ENV=development node esbuild.mjs",
    "dev": "NODE_ENV=development ESBUILD_WATCH=true node esbuild.mjs",
    "check": "tsc",
    "lint": "eslint src",
    "test": "node scripts/test.mjs",
    "test:bundle": "node scripts/bundle-smoke.mjs",
    "package": "npm run build && npm run test:bundle && python3 scripts/package.py",
    "verify": "npm run check && npm run lint && npm test && npm run package"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "author": "D.maggiora",
  "license": "MIT",
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jsdom": "^30.1.3",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "openai": "^6.8.1"
  }
}
